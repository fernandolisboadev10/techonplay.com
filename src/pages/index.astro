---
import { getCollection } from 'astro:content';
import { isPublished } from '../utils/posts';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';

const posts = (await getCollection('blog', isPublished))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 6);
---
<BaseLayout title="AI, Gaming, Security and Tech">
  <section class="hero container">
    <div class="hero-text">
      <p class="eyebrow">techonplay.com<span class="eyebrow-cursor">_</span></p>
      <h1>Tech worth pressing play on.</h1>
      <p class="sub">
        Guides, reviews and news on AI, gaming, security and the tools you use every day.
      </p>
    </div>
  </section>

  <section class="container recent">
    <div class="recent-header">
      <div>
        <h2>Recent articles</h2>
        <span class="underline"></span>
      </div>
      <a href="/blog">See all →</a>
    </div>
    <div class="grid">
      {posts.map((post) => (
        <PostCard
          slug={post.id}
          title={post.data.title}
          description={post.data.description}
          category={post.data.category}
          date={post.data.date}
          readingTime={post.data.readingTime}
          image={post.data.image}
          imageAlt={post.data.imageAlt}
        />
      ))}
    </div>
    <div class="more">
      <a class="more-btn" href="/blog">See more posts</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr;
    padding-block: 72px 48px;
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    margin: 0 0 16px;
    background: linear-gradient(135deg, var(--violet), var(--rose));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .eyebrow-cursor {
    display: inline-block;
    margin-left: 2px;
    color: var(--rose);
    animation: blink 1.1s steps(1) infinite;
  }

  h1 {
    font-size: clamp(2.2rem, 6.2vw, 4.75rem);
    letter-spacing: -0.01em;
  }

  .sub {
    color: var(--ink-soft);
    font-size: 1.05rem;
    max-width: 70ch;
    margin-top: 20px;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .recent {
    padding-block: 40px;
  }

  .recent-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 28px;
  }

  .underline {
    display: block;
    width: 48px;
    height: 4px;
    margin-top: 10px;
    border-radius: 2px;
    background: linear-gradient(135deg, var(--violet), var(--rose));
  }

  .recent-header a {
    text-decoration: none;
    color: var(--teal);
    font-size: 0.9rem;
    white-space: nowrap;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .more {
    display: flex;
    justify-content: center;
    margin-top: 40px;
  }

  .more-btn {
    display: inline-block;
    padding: 16px 40px;
    border-radius: 999px;
    background: linear-gradient(135deg, var(--violet), var(--rose));
    color: #fff;
    font-weight: 700;
    font-size: 1.05rem;
    text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .more-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(160, 40, 160, 0.3);
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 860px) {
    .hero {
      padding-block: 40px 24px;
    }
  }
</style>

