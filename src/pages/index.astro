---
import { getCollection } from 'astro:content';
import { isPublished } from '../utils/posts';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import FeaturedGrid from '../components/FeaturedGrid.astro';
import Pagination from '../components/Pagination.astro';

const PER_PAGE = 9;
const page = Number(Astro.props.page ?? 1);
const all = (await getCollection('blog', isPublished))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featured = page === 1 ? all.slice(0, 3) : [];
const gridAll = all.slice(3);
const totalPages = Math.max(1, Math.ceil(gridAll.length / PER_PAGE));
const rest = gridAll.slice((page - 1) * PER_PAGE, page * PER_PAGE);
---
<BaseLayout title={page > 1 ? `AI, Gaming, Security and Tech - Page ${page}` : "AI, Gaming, Security and Tech"}>
  {page === 1 && (
  <section class="hero container">
    <h1 class="sr-only">Tech worth pressing play on.</h1>
    <p class="eyebrow">techonplay.com<span class="eyebrow-cursor">_</span></p>
  </section>
  )}

  {page === 1 && (
  <section class="container featured-wrap">
    <div class="recent-header">
      <div>
        <h2>Trending now</h2>
        <span class="underline"></span>
      </div>
    </div>
    <FeaturedGrid posts={featured} />
  </section>
  )}

  <section class="container recent">
    <div class="recent-header">
      <div>
        <h2>Fresh off the press</h2>
        <span class="underline"></span>
      </div>
      <a href="/blog">See all →</a>
    </div>
    <div class="grid">
      {rest.map((post, i) => (
        <PostCard
          slug={post.id}
          title={post.data.title}
          description={post.data.description}
          category={post.data.category}
          date={post.data.date}
          readingTime={post.data.readingTime}
          image={post.data.image}
          imageAlt={post.data.imageAlt}
          priority={i === 0}
        />
      ))}
    </div>
    <Pagination current={page} total={totalPages} />
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: 48px 0;
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    margin: 0;
    background: linear-gradient(135deg, var(--violet), var(--rose));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .eyebrow-cursor {
    display: inline-block;
    margin-left: 2px;
    color: var(--rose);
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .featured-wrap {
    padding-block: 32px 8px;
  }

  .recent {
    padding-block: 40px;
  }

  .recent-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 28px;
  }

  .underline {
    display: block;
    width: 48px;
    height: 4px;
    margin-top: 10px;
    border-radius: 2px;
    background: linear-gradient(135deg, var(--violet), var(--rose));
  }

  .recent-header a {
    text-decoration: none;
    color: var(--teal);
    font-size: 0.9rem;
    white-space: nowrap;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .more {
    display: flex;
    justify-content: center;
    margin-top: 40px;
  }

  .more-btn {
    display: inline-block;
    padding: 16px 40px;
    border-radius: 999px;
    background: linear-gradient(135deg, var(--violet), var(--rose));
    color: #fff;
    font-weight: 700;
    font-size: 1.05rem;
    text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .more-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(160, 40, 160, 0.3);
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>

