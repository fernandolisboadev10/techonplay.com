---
import { getCollection } from 'astro:content';
import { isPublished, lastTouched } from '../utils/posts';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import HomeLead from '../components/HomeLead.astro';
import LatestList from '../components/LatestList.astro';
import CategoryBlock from '../components/CategoryBlock.astro';
import SectionHead from '../components/SectionHead.astro';
import TrendBar from '../components/TrendBar.astro';
import Pagination from '../components/Pagination.astro';

// Page 1: lead (3 posts) + "Latest" (the next 9). Pages 2+ continue from there as a card grid,
// so /page/2/ starts exactly where the "Latest" column ends.
const PER_PAGE = 9;
const page = Number(Astro.props.page ?? 1);
const all = (await getCollection('blog', isPublished))
  .sort((a, b) => lastTouched(b) - lastTouched(a));
const lead = all.slice(0, 3);
const gridAll = all.slice(3);
const totalPages = Math.max(1, Math.ceil(gridAll.length / PER_PAGE));
const rest = gridAll.slice((page - 1) * PER_PAGE, page * PER_PAGE);

// One block per category with at least 4 posts outside the lead, biggest categories first.
// There are no category pages here, so "See all" opens the blog filtered by that category.
const blocks = [...new Set(all.map((p) => p.data.category))]
  .map((name) => ({
    name,
    href: `/blog?category=${encodeURIComponent(name)}`,
    total: all.filter((p) => p.data.category === name).length,
    posts: gridAll.filter((p) => p.data.category === name).slice(0, 4),
  }))
  .filter((b) => b.posts.length >= 4)
  .sort((a, b) => b.total - a.total);
---
<BaseLayout title={page > 1 ? `AI, Gaming, Security and Tech - Page ${page}` : "AI, Gaming, Security and Tech"}>
  <h1 class="sr-only">Tech worth pressing play on.</h1>

  {page === 1 ? (
    <>
      <TrendBar posts={all.slice(0, 6)} />

      <section class="container top">
        <div class="top-lead">
          <HomeLead posts={lead} />
        </div>
        <aside class="top-latest" aria-labelledby="latest-title" data-reveal="fade">
          <SectionHead title="Latest" id="latest-title" />
          <LatestList posts={rest} />
          {totalPages > 1 && <a class="more-posts" href="/page/2/">More posts</a>}
        </aside>
      </section>

      {blocks.length > 0 && (
        <div class="container blocks">
          {blocks.map((b) => <div data-reveal="up"><CategoryBlock {...b} /></div>)}
        </div>
      )}
    </>
  ) : (
    <section class="container recent">
      <SectionHead title={`All posts, page ${page}`} />
      <div class="grid" data-reveal="group">
        {rest.map((post, i) => (
          <PostCard
            slug={post.id}
            title={post.data.title}
            description={post.data.description}
            category={post.data.category}
            date={post.data.date}
            updated={post.data.updated}
            readingTime={post.data.readingTime}
            image={post.data.image}
            imageAlt={post.data.imageAlt}
            priority={i === 0}
          />
        ))}
      </div>
      <Pagination current={page} total={totalPages} />
    </section>
  )}
</BaseLayout>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    gap: 40px;
    padding-block: 36px 48px;
  }

  .more-posts {
    display: block;
    margin-top: 12px;
    padding: 11px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    text-align: center;
    transition: border-color var(--dur-normal) ease, color var(--dur-normal) ease;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--ink-strong);
    text-decoration: none;
  }

  .more-posts:hover {
    border-color: var(--violet);
    color: var(--link-text);
  }

  .blocks {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 48px 40px;
    padding-block: 16px 64px;
  }

  .recent {
    padding-block: 40px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  @media (max-width: 960px) {
    .top {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .blocks {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 600px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
  }
</style>
