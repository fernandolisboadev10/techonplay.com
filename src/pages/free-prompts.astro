---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterForm from '../components/NewsletterForm.astro';

const samplePrompts = [
  {
    task: 'Explain an error',
    prompt: 'Explain this error like I have 5 minutes before a meeting: [paste the error]. Give the likely cause and the most direct fix.',
  },
  {
    task: 'Review a function',
    prompt: 'Review this function for bugs, unhandled edge cases, and opportunities to simplify, without changing its public signature: [paste the code]',
  },
  {
    task: 'Write tests',
    prompt: 'Generate unit tests for this function covering the happy path, an expected error, and one non-obvious edge case: [paste the code]',
  },
  {
    task: 'Document an API',
    prompt: 'Write documentation for this API route in OpenAPI format, including a sample request and response: [paste the route code]',
  },
];
---
<BaseLayout title="Free Prompts" description="A free sample of tested AI prompts for developers.">
  <section class="container intro">
    <h1>Free prompts for developers</h1>
    <p>
      A sample of 4 prompts from our library. Leave your email to get the
      other 16 straight to your inbox — and hear about it when new prompts
      drop.
    </p>
    <NewsletterForm />
  </section>

  <section class="container prompts">
    {samplePrompts.map((p) => (
      <div class="prompt-card">
        <p class="task">{p.task}</p>
        <pre><code>{p.prompt}</code></pre>
      </div>
    ))}
  </section>

  <section class="container locked">
    <p class="locked-label">+ 16 prompts (email required)</p>
    <p class="locked-copy">
      Advanced debugging, safe refactoring, integration test generation,
      PR review prompts, and more.
    </p>
  </section>
</BaseLayout>

<style>
  .intro {
    padding-block: 56px 32px;
    max-width: 60ch;
  }

  .intro p {
    color: var(--ink-soft);
    margin: 16px 0 28px;
  }

  .prompts {
    display: grid;
    gap: 20px;
    padding-block: 24px;
  }

  .prompt-card {
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 20px 24px;
    background: var(--surface);
  }

  .task {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--violet);
    margin: 0 0 12px;
  }

  pre {
    margin: 0;
    white-space: pre-wrap;
    font-family: var(--font-mono);
    font-size: 0.88rem;
    color: var(--ink);
  }

  .locked {
    margin-block: 40px 80px;
    padding: 32px;
    border: 1px dashed var(--line);
    border-radius: 8px;
    text-align: center;
  }

  .locked-label {
    font-family: var(--font-mono);
    color: var(--ink-strong);
    font-weight: 500;
    margin: 0 0 8px;
  }

  .locked-copy {
    color: var(--ink-soft);
    margin: 0;
    max-width: 48ch;
    margin-inline: auto;
  }
</style>
