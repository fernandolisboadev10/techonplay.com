---
import { getCollection, render } from 'astro:content';
import PostLayout from '../layouts/PostLayout.astro';
import { isPublished } from '../utils/posts';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', isPublished)).sort(
    (a, b) => a.data.date.valueOf() - b.data.date.valueOf(),
  );
  const link = (p?: (typeof posts)[number]) => (p ? { slug: p.id, title: p.data.title } : undefined);
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, prev: link(posts[i - 1]), next: link(posts[i + 1]) },
  }));
}

const { post, prev, next } = Astro.props;
const { Content } = await render(post);
---
<PostLayout
  title={post.data.title}
  description={post.data.description}
  category={post.data.category}
  date={post.data.date}
  readingTime={post.data.readingTime}
  image={post.data.image}
  imageAlt={post.data.imageAlt}
  prev={prev}
  next={next}
>
  <Content />
</PostLayout>
