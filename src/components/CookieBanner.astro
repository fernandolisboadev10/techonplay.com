---
<div class="cookie-banner" id="cookie-banner" role="dialog" aria-live="polite" aria-label="Cookie preferences" hidden>
  <p>
    We use cookies for analytics and ads. You can accept or reject non-essential cookies.
    <a href="/cookie-policy">Learn more</a>
  </p>
  <div class="actions">
    <button type="button" class="btn btn-ghost" data-consent="denied">Reject</button>
    <button type="button" class="btn btn-solid" data-consent="granted">Accept</button>
  </div>
</div>

<script>
  const banner = document.getElementById('cookie-banner');
  const consent = (window as any).techonplayConsent;

  if (banner && consent) {
    if (!consent.hasChoice()) banner.hidden = false;

    banner.querySelectorAll<HTMLButtonElement>('[data-consent]').forEach((btn) => {
      btn.addEventListener('click', () => {
        consent.set(btn.dataset.consent);
        banner.hidden = true;
      });
    });

    document.querySelectorAll('[data-open-cookie-settings]').forEach((el) => {
      el.addEventListener('click', (e) => {
        e.preventDefault();
        banner.hidden = false;
      });
    });
  }
</script>

<style>
  .cookie-banner {
    position: fixed;
    inset: auto 16px 16px 16px;
    z-index: 50;
    max-width: 720px;
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 20px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 12px;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.25);
  }

  .cookie-banner[hidden] {
    display: none;
  }

  p {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--ink);
  }

  p a {
    color: var(--link);
  }

  .actions {
    display: flex;
    gap: 8px;
    flex-shrink: 0;
  }

  .btn {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.85rem;
    padding: 9px 18px;
    border-radius: 8px;
    border: 1px solid var(--violet);
    cursor: pointer;
  }

  .btn-solid {
    background: var(--violet);
    color: var(--bg);
  }

  .btn-ghost {
    background: transparent;
    color: var(--violet);
  }

  @media (max-width: 560px) {
    .cookie-banner {
      flex-direction: column;
      align-items: stretch;
    }

    .actions {
      justify-content: flex-end;
    }
  }
</style>
