---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import CategoryLabel from './CategoryLabel.astro';

interface Props {
  slug: string;
  title: string;
  description: string;
  category: string;
  date?: Date;
  updated?: Date;
  readingTime?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  priority?: boolean;
}
const { slug, title, description, category, date, updated, readingTime, image, imageAlt, priority = false } = Astro.props;

const formattedDate = date?.toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC',
});

// Same rule as the post header: only when edited on a later day than published.
const formattedUpdated = updated?.toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  timeZone: 'UTC',
});
const showUpdated =
  !!date && !!updated && updated.getTime() > date.getTime() && updated.toISOString().slice(0, 10) !== date.toISOString().slice(0, 10);
---
<a href={`/${slug}`} class="card">
  <span class="thumb">
    {image && <Image src={image} alt={imageAlt ?? title} width={480} height={320} quality={70} priority={priority} />}
  </span>
  <span class="body">
    <CategoryLabel category={category} />
    <h3>{title}</h3>
    <p class="description">{description}</p>
    {(formattedDate || readingTime) && (
      <span class="meta">
        {formattedDate}{formattedDate && readingTime && ', '}{readingTime && `${readingTime} read`}
        {showUpdated && <span class="updated"> | Updated {formattedUpdated}</span>}
      </span>
    )}
  </span>
</a>

<style>
  .updated {
    color: var(--violet);
    font-weight: 600;
  }

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0;
    height: 100%;
    color: inherit;
    text-decoration: none;
    background: transparent;
  }

  .thumb {
    display: block;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: linear-gradient(135deg, var(--violet-soft), var(--rose-soft));
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
    padding: 14px 0 0;
  }

  h3 {
    font-size: 1.19rem;
    line-height: 1.18;
    letter-spacing: -0.012em;
    color: var(--ink-strong);
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 2px no-repeat;
    transition: background-size 0.22s;
    align-self: flex-start;
  }

  .card:hover h3 {
    background-size: 100% 2px;
  }

  .description {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.97rem;
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .meta {
    margin-top: auto;
    padding-top: 10px;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* Phones: compact rows with the picture beside the title, several posts per screen. */
  @media (max-width: 600px) {
    .card {
      flex-direction: row-reverse;
      align-items: flex-start;
      gap: 14px;
      padding-block: 16px;
      border: 0;
      border-top: 1px solid var(--line);
      border-radius: 0;
      background: transparent;
    }

    .card,
    .card:hover {
      transform: none;
      box-shadow: none;
    }

    .body {
      padding: 0;
    }

    .thumb {
      flex: none;
      width: 104px;
      aspect-ratio: 1;
      border: 0;
      border-radius: 6px;
    }

    h3 {
      font-size: 1.02rem;
    }

    .description {
      display: none;
    }
  }
</style>
