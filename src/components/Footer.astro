---
const categories = [
  { label: 'Home', href: '/' },
  { label: 'Artificial Intelligence', href: '/blog?category=AI' },
  { label: 'Gaming', href: '/blog?category=Gaming' },
  { label: 'Guides', href: '/blog?category=Guides' },
  { label: 'Reviews', href: '/blog?category=Reviews' },
  { label: 'Security', href: '/blog?category=Security' },
  { label: 'Tools', href: '/blog?category=Tools' },
  { label: 'Trends', href: '/blog?category=Trends' },
];

const quickLinks = [
  { label: 'About Us', href: '/about-us' },
  { label: 'Contact', href: '/contact-us' },
  { label: 'Advertise', href: '/advertise' },
];
---
<footer class="site-footer">
  <div class="container grid">
    <div class="about-col">
      <a href="/" class="brand" aria-label="TechOnPlay - Home">
        <img class="brand-logo" src="/images/logo.webp" alt="TechOnPlay" width="171" height="26" />
      </a>
      <p class="tagline">
        TechOnPlay covers AI, gaming, security and tech: tested tools, honest reviews and practical guides to help you get more out of the technology you use every day.
      </p>
    </div>

    <div>
      <p class="col-title">Quick Links</p>
      <ul>
        {quickLinks.map((l) => (
          <li><a href={l.href}>{l.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <p class="col-title">Category</p>
      <ul class="cats" style={`grid-template-rows: repeat(${Math.ceil(categories.length / 2)}, auto)`}>
        {categories.map((c) => (
          <li><a href={c.href}>{c.label}</a></li>
        ))}
      </ul>
    </div>

  </div>

  <div class="bottom">
    <div class="container bottom-inner">
      <p>© {new Date().getFullYear()} TechOnPlay. All rights reserved.</p>
      <div class="legal-links">
        <a href="/privacy-policy">Privacy Policy</a>
        <a href="/terms-of-use">Terms of Use</a>
        <a href="/cookie-policy">Cookie Policy</a>
        <a href="#" data-open-cookie-settings>Cookie settings</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 80px;
    background: var(--inverse);
    color: #cfc7ea;
  }

  .grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1.5fr;
    gap: 40px;
    padding-block: 56px 40px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    margin: 0 0 16px;
  }

  .brand-logo {
    display: block;
    height: 26px;
    width: auto;
  }

  .tagline {
    color: #cfc7ea;
    font-size: 0.95rem;
    max-width: 38ch;
    margin: 0 0 20px;
  }

  .col-title {
    position: relative;
    margin: 0 0 18px;
    padding-bottom: 12px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #a99fd0;
  }

  .col-title::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 28px;
    height: 2px;
    background: var(--rose-soft);
  }



  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  ul.cats {
    display: grid;
    grid-auto-flow: column;
    column-gap: 32px;
    row-gap: 9px;
  }

  ul a {
    text-decoration: none;
    color: #e9e4fb;
    font-size: 0.95rem;
  }

  ul a:hover {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .bottom {
    background: var(--ink-deep);
  }

  .bottom-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    padding-block: 20px;
  }

  .bottom-inner p {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: rgba(255, 255, 255, 0.75);
  }

  .legal-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
  }

  .legal-links a {
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: rgba(255, 255, 255, 0.75);
  }

  .legal-links a:hover {
    color: #ffffff;
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 560px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .bottom-inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
