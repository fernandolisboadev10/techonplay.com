---
import { socials } from '../data/socials';
---
<aside class="author-bio">
  <img
    src="/images/fernando-lisboa.png"
    alt="Fernando Lisboa"
    class="author-photo"
    width="56"
    height="56"
    loading="lazy"
  />
  <div class="author-body">
    <p>
      <strong>Fernando Lisboa</strong> is an independent Systems Analyst and Tech
      Writer from Brazil who tests AI tools and writes guides for developers.
    </p>
    <ul class="author-social" aria-label="Fernando Lisboa on social media">
      {socials.map((s) => (
        <li>
          <a href={s.href} target="_blank" rel="noopener noreferrer me">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d={s.path} /></svg>
            {s.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</aside>

<style>
  .author-bio {
    display: flex;
    gap: 16px;
    align-items: center;
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--violet-soft);
  }

  .author-photo {
    flex-shrink: 0;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    object-fit: cover;
  }

  .author-body {
    min-width: 0;
  }

  .author-body p {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--ink-soft);
  }

  .author-bio strong {
    color: var(--ink);
  }

  .author-social {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 14px;
    margin: 12px 0 0;
    padding: 0;
  }

  .author-social a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--ink-soft);
    text-decoration: none;
  }

  .author-social a:hover {
    color: var(--teal);
  }

  @media (max-width: 600px) {
    .author-bio {
      align-items: flex-start;
    }
  }
</style>
