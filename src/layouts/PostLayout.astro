---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from './BaseLayout.astro';
import AuthorBio from '../components/AuthorBio.astro';
import ShareButtons from '../components/ShareButtons.astro';
import PostNav from '../components/PostNav.astro';
import TableOfContents from '../components/TableOfContents.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import type { MarkdownHeading } from 'astro';

interface Props {
  title: string;
  seoTitle?: string;
  description: string;
  category: string;
  date: Date;
  updated?: Date;
  readingTime?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  prev?: { slug: string; title: string };
  next?: { slug: string; title: string };
  headings?: MarkdownHeading[];
}
const { title, seoTitle, description, category, date, updated, readingTime, image, imageAlt, prev, next, headings = [] } = Astro.props;

// There are no category pages on this site: the category link opens the blog filtered by it.
const categoryHref = `/blog?category=${encodeURIComponent(category)}`;

// Same threshold as TableOfContents: the side guide only shows up for posts with 3+ sections.
const hasGuide = headings.filter((h) => h.depth === 2).length >= 3;

// The category only exists as a filtered blog URL, so the structured breadcrumb skips it.
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: title },
  ],
};

const formattedDate = date.toLocaleDateString('en-US', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});

// "Updated" only shows when the post was edited on a later day than it was published.
const formattedUpdated = updated?.toLocaleDateString('en-US', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
const showUpdated = !!formattedUpdated && formattedUpdated !== formattedDate && updated!.getTime() > date.getTime();

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  image: image ? new URL(image.src, Astro.site).toString() : undefined,
  datePublished: date.toISOString(),
  dateModified: (updated ?? date).toISOString(),
  author: {
    '@type': 'Person',
    name: 'Fernando Lisboa',
  },
  publisher: {
    '@type': 'Organization',
    name: 'TechOnPlay',
    logo: {
      '@type': 'ImageObject',
      url: new URL('/images/logo.png', Astro.site).toString(),
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': new URL(Astro.url.pathname, Astro.site).toString(),
  },
};
---
<BaseLayout title={seoTitle ?? title} description={description} image={image?.src} type="article">
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <ReadingProgress />
  <div class:list={['container post-shell', { 'no-guide': !hasGuide }]}>
    <article class="post">
      <header class="post-head">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true">›</span>
          <a href={categoryHref}>{category}</a>
        </nav>
        <h1>{title}</h1>
        <p class="meta">
          By <a href="/about-us/">Fernando Lisboa</a> | <time datetime={date.toISOString()}>{formattedDate}</time>{showUpdated && <> | Updated <time datetime={updated!.toISOString()}>{formattedUpdated}</time></>}{readingTime && `, ${readingTime} read`}
        </p>
        <ShareButtons title={title} />

        {image && (
          <div class="hero-image">
            <Image src={image} alt={imageAlt ?? title} width={720} height={480} quality={70} priority />
          </div>
        )}
      </header>

      <div class="post-body">
        <div class="prose">
          <slot />
        </div>

        <ShareButtons title={title} variant="end" />

        <PostNav prev={prev} next={next} />

        <div data-reveal="up"><AuthorBio /></div>
      </div>
    </article>

    {hasGuide && (
      <aside class="post-aside">
        <TableOfContents headings={headings} />
      </aside>
    )}
  </div>
</BaseLayout>

<script>
  function legacyCopy(text: string): boolean {
    const textarea = document.createElement('textarea');
    textarea.value = text;
    textarea.style.position = 'fixed';
    textarea.style.opacity = '0';
    document.body.appendChild(textarea);
    textarea.select();
    let ok = false;
    try {
      ok = document.execCommand('copy');
    } catch {
      ok = false;
    }
    document.body.removeChild(textarea);
    return ok;
  }


  document.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('.copy-btn');
    if (!button) return;

    const targetId = button.dataset.copyTarget;
    const target = targetId && document.getElementById(targetId);
    if (!target) return;

    const text = target.textContent?.trim() ?? '';
    const original = button.textContent;

    const showFeedback = (label: string, isError: boolean) => {
      button.textContent = label;
      button.classList.toggle('copied', !isError);
      button.classList.toggle('copy-error', isError);
      setTimeout(() => {
        button.textContent = original;
        button.classList.remove('copied', 'copy-error');
      }, 1500);
    };

    if (navigator.clipboard?.writeText) {
      navigator.clipboard.writeText(text).then(
        () => showFeedback('Copied!', false),
        () => {
          const ok = legacyCopy(text);
          showFeedback(ok ? 'Copied!' : 'Press Ctrl+C', !ok);
        },
      );
    } else {
      const ok = legacyCopy(text);
      showFeedback(ok ? 'Copied!' : 'Press Ctrl+C', !ok);
    }
  });
</script>

<style>
  /* Article and guide side by side on desktop; the guide drops between cover and text on smaller screens. */
  .post-shell {
    padding-block: 40px 56px;
    display: grid;
    grid-template-columns: minmax(0, 760px) 280px;
    grid-template-areas: 'post aside';
    justify-content: space-between;
    column-gap: 48px;
  }

  .post-head,
  .post-body,
  .post-aside {
    min-width: 0;
  }

  .post {
    grid-area: post;
    min-width: 0;
  }

  .post-aside {
    grid-area: aside;
    padding-top: 36px;
  }

  .post-shell.no-guide {
    max-width: 768px;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: 'post';
  }

  @media (max-width: 1099px) {
    /* Header, guide and body share one grid so the guide sits between cover and text. */
    .post-shell,
    .post-shell.no-guide {
      max-width: 768px;
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'head' 'aside' 'body';
    }

    .post {
      display: contents;
    }

    .post-head {
      grid-area: head;
    }

    .post-aside {
      grid-area: aside;
      padding-top: 0;
      margin-bottom: 32px;
    }

    .post-body {
      grid-area: body;
      min-width: 0;
    }
  }

  .crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin: 0 0 18px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .crumbs a {
    color: var(--ink-soft);
    text-decoration: none;
  }

  .crumbs a:last-child {
    color: var(--ink-strong);
  }

  .crumbs a:hover {
    color: var(--link-text);
  }

  h1 {
    font-size: clamp(2.2rem, 4.6vw, 3.4rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.02;
    text-wrap: balance;
    margin-bottom: 18px;
  }

  .meta {
    margin: 0 0 20px;
    padding-block: 16px;
    border-block: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .meta a {
    color: var(--ink-strong);
    text-decoration: none;
    font-weight: 600;
  }

  .meta a:hover {
    color: var(--link-text);
  }

  .hero-image {
    aspect-ratio: 3 / 2;
    border-radius: var(--radius-md);
    overflow: hidden;
    margin-bottom: 40px;
    background: var(--surface-2);
  }

  .hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  :global(.prompt-card) {
    margin: 24px 0;
    border-radius: 6px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  :global(.prompt-card-bar) {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 14px;
    background: var(--ink-deep);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  :global(.prompt-card-bar .dot) {
    width: 9px;
    height: 9px;
    border-radius: 50%;
  }

  :global(.prompt-card-bar .dot-red) {
    background: #ff5f56;
  }

  :global(.prompt-card-bar .dot-yellow) {
    background: #ffbd2e;
  }

  :global(.prompt-card-bar .dot-green) {
    background: #27c93f;
  }

  :global(.prompt-card-label) {
    margin-left: 4px;
    flex: 1;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.45);
  }

  :global(.copy-btn) {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 5px 11px;
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.15);
    background: rgba(255, 255, 255, 0.06);
    color: #ece7fb;
    cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }

  :global(.copy-btn:hover) {
    border-color: var(--teal-soft);
    color: var(--teal-soft);
  }

  :global(.copy-btn.copied) {
    background: var(--teal);
    border-color: var(--teal);
    color: #ffffff;
  }

  :global(.copy-btn.copy-error) {
    background: var(--rose);
    border-color: var(--rose);
    color: #ffffff;
  }

  :global(.prompt-card pre) {
    margin: 0;
    border-radius: 0;
  }

  :global(.prompt-box) {
    margin: 24px 0;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 16px 32px -20px rgba(91, 33, 182, 0.35);
    background: var(--ink-deep);
  }

  :global(.prompt-box-bar) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 14px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.55);
  }

  :global(.prompt-box pre) {
    margin: 0;
    padding: 16px;
    border: 0;
    border-radius: 0;
    background: transparent !important;
    color: #ece7fb;
    font-style: italic;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    overflow-x: visible;
  }

  :global(.prompt-box pre code),
  :global(.prompt-box pre span) {
    font-style: italic;
    color: inherit !important;
    white-space: pre-wrap;
  }
</style>
